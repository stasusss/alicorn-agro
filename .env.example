# Production (Neon):
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
#
# Local embedded Postgres (PGlite):
DATABASE_URL=pglite:./.data/pglite

AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# Demo seed credentials
SEED_USER_EMAIL=client@example.com
SEED_USER_PASSWORD=changeme
SEED_GATEWAY_API_KEY=gw_demo_key_change_me

# Alerts (optional for local)
RESEND_API_KEY=
ALERT_EMAIL_FROM=alerts@alicorn-agro.com
TELEGRAM_BOT_TOKEN=

# Offsite backups. Never commit key material.
# The scheduled job runs in the private repo named by BACKUP_GITHUB_REPO.
# BACKUP_GITHUB_REPO=stasusss/alicorn-agro-backups
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
AGE_RECIPIENT=
# Secret age key, restore only. Prefer a file outside the repo: AGE_IDENTITY_FILE=
AGE_IDENTITY=
# Empty database. Must not be the same host and database as DATABASE_URL.
RESTORE_DATABASE_URL=
